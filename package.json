{
  "name": "embidly",
  "version": "1.1.2",
  "type": "module",
  "description": "Drop-in WhatsApp-style floating AI ChatBot for websites powered by Google Gemini",
  "main": "./dist/embidly.umd.cjs",
  "module": "./dist/embidly.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "embidly": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/embidly.js",
      "require": "./dist/embidly.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode lib && node -e \"require('fs').copyFileSync('src/lib.d.ts', 'dist/lib.d.ts')\"",
    "prepublishOnly": "npm run build",
    "postinstall": "node bin/cli.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.24.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/James-Lucky/embidly.git"
  },
  "keywords": [
    "npm",
    "chatbot",
    "gemini",
    "ai",
    "react",
    "widget",
    "float",
    "copilot"
  ],
  "author": "lucky",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/James-Lucky/embidly/issues"
  },
  "homepage": "https://github.com/James-Lucky/embidly#readme"
}
